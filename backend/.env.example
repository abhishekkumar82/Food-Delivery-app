# Backend environment variables — copy to `.env` and fill in real values.
# NODE_ENV=production disables dev-only helpers (e.g. coupon seeding).
NODE_ENV=development

# MongoDB connection string (local or Atlas)
MONGODB_CONECTION_STRING=mongodb://localhost:27017/mern-food-app

# The frontend origin allowed by CORS / Socket.io
FRONTEND_URL=http://localhost:5173

# Auth0 (API / audience)
AUTH0_AUDIENCE=your-auth0-api-audience
AUTH0_ISSUER_BASE_URL=https://your-tenant.us.auth0.com

# Cloudinary (restaurant image uploads)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-key
CLOUDINARY_API_SECRET=your-cloudinary-secret

# Stripe (payments)
STRIPE_API_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Optional: enables the Tier 3 AI features (recommender, NL search, review summary).
# Leave unset to use the heuristic fallbacks.
# ANTHROPIC_API_KEY=sk-ant-xxx
