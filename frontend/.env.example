# Frontend environment variables — copy to `.env` and fill in real values.
# All VITE_* values are bundled into the client, so use only public-safe values.

# Base URL of the backend API
VITE_API_BASE_URL=http://localhost:7000

# Auth0 SPA config (these are public client identifiers, not secrets)
VITE_AUTH0_DOMAIN=your-tenant.us.auth0.com
VITE_AUTH0_CLIENT_ID=your-auth0-spa-client-id
VITE_AUTH0_CALLBACK_URL=http://localhost:5173/auth-callback
VITE_AUTH0_AUDIENCE=your-auth0-api-audience
